FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 DBT_SEND_ANONYMOUS_USAGE_STATS=false DBT_PROFILES_DIR=/app/analytics DBT_PROJECT_DIR=/app/analytics DBT_TARGET_PATH=/tmp/dbt-target DBT_LOG_PATH=/tmp/dbt-logs
WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir '.[test]' dbt-core==1.12.5 dbt-postgres==1.11.0 && useradd --create-home worker
COPY analytics ./analytics
COPY tests ./tests
USER worker
CMD ["dbt", "build"]
